# Used by `npm run dev:mock` and `vite build --mode mock` for deterministic mock translations.
# Blank values override .env.local so no AI URL or key is compiled into mock builds.
VITE_AI_PROVIDER=mock
VITE_AI_API_URL=
VITE_AI_MODEL=
VITE_AI_API_KEY=
VITE_AI_TIMEOUT_MS=
VITE_AI_TEMPERATURE=
VITE_AI_SEED=
