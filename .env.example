# Production builds need NO .env file: by default the app posts to ./api/chat.ashx (ASP.NET) and falls back
# to ./api/chat.php (PHP); the AI server, model, and API key are set on the server in api/chat.config.json or api/config.php.
#
# Use these only to override that, mainly for local development without PHP.
# Copy to .env.development.local (read by `npm run dev` only, so `npm run build` is unaffected).
# Every VITE_ value is compiled into the JavaScript bundle and is readable in the browser.

# backend (default: api/chat.ashx, then api/chat.php) | mock | ollama | openai (any OpenAI-compatible /chat/completions API)
VITE_AI_PROVIDER=ollama

# backend: ./api/chat.ashx then ./api/chat.php (default)   ollama: http://localhost:11434   openai-compatible: https://api.openai.com/v1
VITE_AI_API_URL=http://localhost:11434

# Not used by backend (the model comes from api/config.php).
VITE_AI_MODEL=qwen2.5:7b

# Not used by backend. For direct calls it is sent as "Authorization: Bearer <key>" and is visible in the browser.
VITE_AI_API_KEY=

VITE_AI_TIMEOUT_MS=60000

# 0-2. Lower values give more consistent wording. Default 0.2; 0 is the most repeatable.
VITE_AI_TEMPERATURE=0

# Optional whole number. With the same model, prompt, and temperature 0, Ollama repeats the same answer.
VITE_AI_SEED=42

# Optional IIS reverse proxy instead of PHP (see README). Not compiled into the browser bundle.
# Set VITE_AI_API_URL=./ai and AI_PROXY_TARGET to the real AI base URL; the build adds a rule to dist/web.config.
AI_PROXY_TARGET=
AI_PROXY_CLEAR_ORIGIN=false
