# Copy to .env.local (development) or .env.production.local (npm run build) and fill in.
# Every VITE_ value is compiled into the JavaScript bundle and is readable in the browser.
# Do not put a secret API key here unless you accept that anyone who can open the site can read it.

# mock | ollama | openai (any OpenAI-compatible /chat/completions API)
VITE_AI_PROVIDER=ollama

# ollama: http://localhost:11434   openai-compatible: https://api.openai.com/v1
VITE_AI_API_URL=http://localhost:11434

VITE_AI_MODEL=qwen2.5-coder:7b

# Sent as "Authorization: Bearer <key>" when set. Leave empty for Ollama.
VITE_AI_API_KEY=

VITE_AI_TIMEOUT_MS=60000

# 0-2. Lower values give more consistent wording. Default 0.2; 0 is the most repeatable.
VITE_AI_TEMPERATURE=0

# Optional whole number. With the same model, prompt, and temperature 0, Ollama repeats the same answer.
# Hosted APIs treat the seed as best effort. Leave empty to use a random seed.
VITE_AI_SEED=42
